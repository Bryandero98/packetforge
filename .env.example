# Required. A reachable Postgres connection string.
# Local dev: see docs/epics/next-gen-features.md (Phase 0) for a docker-compose
# option once it lands - for now, point this at any Postgres you have.
DATABASE_URL=postgres://user:password@localhost:5432/packetforge

# Optional. Defaults to 3000.
PORT=3000

# Required only to write/query embeddings (POST /decisions, POST /debt,
# GET /graph/search) - everything else works with no key configured.
# Free, no card required: aistudio.google.com -> "Get API key".
GEMINI_API_KEY=
